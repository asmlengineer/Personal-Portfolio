<%- include('partials/Navbar.ejs') %>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Notes</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-950 text-white">
  <!-- ================= NOTES HERO ================= -->

    <section class="py-20 bg-gray-950">

        <div class="max-w-5xl mx-auto px-6 text-center">

            <p class="text-blue-400 font-semibold tracking-widest">
                MY NOTES
            </p>

            <h1 class="text-4xl md:text-5xl font-bold mt-3">
                Learning & Development Notes
            </h1>

            <p class="text-gray-400 max-w-3xl mx-auto mt-6
                      text-lg leading-relaxed">
                A collection of my programming notes, development
                concepts, useful resources and things I have learned
                while building projects.
            </p>


            <!-- Search Box -->

            <div class="max-w-2xl mx-auto mt-8">

                <div class="relative">

                    <input
                        type="text"
                        placeholder="Search notes..."
                        class="w-full bg-gray-900
                               border border-gray-700
                               rounded-xl
                               px-5 py-4
                               pr-14
                               text-white
                               placeholder-gray-500
                               outline-none
                               focus:border-blue-500
                               focus:ring-2
                               focus:ring-blue-500/20
                               transition">

                    <button
                        class="absolute right-3 top-1/2
                               -translate-y-1/2
                               bg-blue-600
                               hover:bg-blue-700
                               px-4 py-2
                               rounded-lg
                               transition">
                        🔍
                    </button>

                </div>

            </div>

        </div>

    </section>

    <!-- ================= NOTES SECTION ================= -->

    <section class="py-16 bg-gray-900">

        <div class="max-w-7xl mx-auto px-6">


            <!-- Section Heading -->

            <div class="flex flex-col md:flex-row
                        justify-between
                        items-center
                        gap-5 mb-12">

                <div>

                    <p class="text-blue-400 font-semibold">
                        KNOWLEDGE BASE
                    </p>

                    <h2 class="text-3xl font-bold mt-2">
                        Latest Notes
                    </h2>

                </div>


                <!-- Category Buttons -->

                <div class="flex flex-wrap justify-center gap-2">

                    <button
                        class="bg-blue-600
                               px-4 py-2
                               rounded-lg
                               text-sm
                               font-semibold">
                        All
                    </button>

                    <button
                        class="bg-gray-800
                               hover:bg-gray-700
                               px-4 py-2
                               rounded-lg
                               text-sm">
                        HTML/CSS
                    </button>

                    <button
                        class="bg-gray-800
                               hover:bg-gray-700
                               px-4 py-2
                               rounded-lg
                               text-sm">
                        JavaScript
                    </button>

                    <button
                        class="bg-gray-800
                               hover:bg-gray-700
                               px-4 py-2
                               rounded-lg
                               text-sm">
                        React
                    </button>

                    <button
                        class="bg-gray-800
                               hover:bg-gray-700
                               px-4 py-2
                               rounded-lg
                               text-sm">
                        Backend
                    </button>

                </div>

            </div>



            <!-- ================= NOTES GRID ================= -->

            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">


                <!-- Note 1 -->

                <article
                    class="bg-gray-950
                           border border-gray-800
                           rounded-2xl
                           p-6
                           hover:border-blue-500
                           hover:-translate-y-2
                           transition duration-300">

                    <div class="flex items-center
                                justify-between">

                        <span class="bg-orange-600/20
                                     text-orange-400
                                     px-3 py-1
                                     rounded-full
                                     text-sm">
                            HTML
                        </span>

                        <span class="text-gray-500 text-sm">
                            Sep 10, 2026
                        </span>

                    </div>


                    <h3 class="text-2xl font-bold mt-5">
                        HTML Basics
                    </h3>


                    <p class="text-gray-400 mt-3 leading-relaxed">
                        Important HTML elements, semantic tags,
                        forms, tables, links and the basic structure
                        of a modern webpage.
                    </p>


                    <div class="flex flex-wrap gap-2 mt-5">

                        <span class="text-xs bg-gray-800
                                     text-gray-400
                                     px-2 py-1 rounded">
                            HTML
                        </span>

                        <span class="text-xs bg-gray-800
                                     text-gray-400
                                     px-2 py-1 rounded">
                            Web Development
                        </span>

                    </div>


                    <a href="/download/1.pdf"
                       class="inline-block mt-6
                              text-blue-400
                              font-semibold
                              hover:text-blue-300">
                        Download      
                        </a>
                </article>

                <!-- Note 2 -->

                <article
                    class="bg-gray-950
                           border border-gray-800
                           rounded-2xl
                           p-6
                           hover:border-blue-500
                           hover:-translate-y-2
                           transition duration-300">

                    <div class="flex items-center
                                justify-between">

                        <span class="bg-blue-600/20
                                     text-blue-400
                                     px-3 py-1
                                     rounded-full
                                     text-sm">
                            CSS
                        </span>

                        <span class="text-gray-500 text-sm">
                            Sep 08, 2026
                        </span>

                    </div>


                    <h3 class="text-2xl font-bold mt-5">
                        CSS Flexbox & Grid
                    </h3>


                    <p class="text-gray-400 mt-3 leading-relaxed">
                        Notes covering Flexbox, CSS Grid, responsive
                        layouts, positioning and modern website
                        styling techniques.
                    </p>


                    <div class="flex flex-wrap gap-2 mt-5">

                        <span class="text-xs bg-gray-800
                                     text-gray-400
                                     px-2 py-1 rounded">
                            CSS
                        </span>

                        <span class="text-xs bg-gray-800
                                     text-gray-400
                                     px-2 py-1 rounded">
                            Responsive
                        </span>

                    </div>


                    <a href="#"
                       class="inline-block mt-6
                              text-blue-400
                              font-semibold
                              hover:text-blue-300">
                        Read Note →
                    </a>

                </article>



                <!-- Note 3 -->

                <article
                    class="bg-gray-950
                           border border-gray-800
                           rounded-2xl
                           p-6
                           hover:border-blue-500
                           hover:-translate-y-2
                           transition duration-300">

                    <div class="flex items-center
                                justify-between">

                        <span class="bg-yellow-600/20
                                     text-yellow-400
                                     px-3 py-1
                                     rounded-full
                                     text-sm">
                            JavaScript
                        </span>

                        <span class="text-gray-500 text-sm">
                            Sep 05, 2026
                        </span>

                    </div>


                    <h3 class="text-2xl font-bold mt-5">
                        JavaScript Fundamentals
                    </h3>


                    <p class="text-gray-400 mt-3 leading-relaxed">
                        Variables, functions, arrays, objects,
                        DOM manipulation, events and important
                        JavaScript concepts.
                    </p>


                    <div class="flex flex-wrap gap-2 mt-5">

                        <span class="text-xs bg-gray-800
                                     text-gray-400
                                     px-2 py-1 rounded">
                            JavaScript
                        </span>

                        <span class="text-xs bg-gray-800
                                     text-gray-400
                                     px-2 py-1 rounded">
                            Programming
                        </span>

                    </div>


                    <a href="#"
                       class="inline-block mt-6
                              text-blue-400
                              font-semibold
                              hover:text-blue-300">
                        Read Note →
                    </a>

                </article>



                <!-- Note 4 -->

                <article
                    class="bg-gray-950
                           border border-gray-800
                           rounded-2xl
                           p-6
                           hover:border-blue-500
                           hover:-translate-y-2
                           transition duration-300">

                    <div class="flex items-center
                                justify-between">

                        <span class="bg-cyan-600/20
                                     text-cyan-400
                                     px-3 py-1
                                     rounded-full
                                     text-sm">
                            React
                        </span>

                        <span class="text-gray-500 text-sm">
                            Sep 02, 2026
                        </span>

                    </div>


                    <h3 class="text-2xl font-bold mt-5">
                        React Components
                    </h3>


                    <p class="text-gray-400 mt-3 leading-relaxed">
                        Understanding components, props, state,
                        events, hooks and reusable UI patterns
                        in React applications.
                    </p>


                    <div class="flex flex-wrap gap-2 mt-5">

                        <span class="text-xs bg-gray-800
                                     text-gray-400
                                     px-2 py-1 rounded">
                            React
                        </span>

                        <span class="text-xs bg-gray-800
                                     text-gray-400
                                     px-2 py-1 rounded">
                            Frontend
                        </span>

                    </div>


                    <a href="#"
                       class="inline-block mt-6
                              text-blue-400
                              font-semibold
                              hover:text-blue-300">
                        Read Note →
                    </a>

                </article>



                <!-- Note 5 -->

                <article
                    class="bg-gray-950
                           border border-gray-800
                           rounded-2xl
                           p-6
                           hover:border-blue-500
                           hover:-translate-y-2
                           transition duration-300">

                    <div class="flex items-center
                                justify-between">

                        <span class="bg-green-600/20
                                     text-green-400
                                     px-3 py-1
                                     rounded-full
                                     text-sm">
                            Node.js
                        </span>

                        <span class="text-gray-500 text-sm">
                            Aug 30, 2026
                        </span>

                    </div>


                    <h3 class="text-2xl font-bold mt-5">
                        Node.js & Express
                    </h3>


                    <p class="text-gray-400 mt-3 leading-relaxed">
                        Notes about Node.js, Express routes,
                        middleware, request-response handling
                        and REST API development.
                    </p>


                    <div class="flex flex-wrap gap-2 mt-5">

                        <span class="text-xs bg-gray-800
                                     text-gray-400
                                     px-2 py-1 rounded">
                            Node.js
                        </span>

                        <span class="text-xs bg-gray-800
                                     text-gray-400
                                     px-2 py-1 rounded">
                            Express
                        </span>

                    </div>


                    <a href="#"
                       class="inline-block mt-6
                              text-blue-400
                              font-semibold
                              hover:text-blue-300">
                        Read Note →
                    </a>

                </article>



                <!-- Note 6 -->

                <article
                    class="bg-gray-950
                           border border-gray-800
                           rounded-2xl
                           p-6
                           hover:border-blue-500
                           hover:-translate-y-2
                           transition duration-300">

                    <div class="flex items-center
                                justify-between">

                        <span class="bg-green-600/20
                                     text-green-400
                                     px-3 py-1
                                     rounded-full
                                     text-sm">
                            Database
                        </span>

                        <span class="text-gray-500 text-sm">
                            Aug 27, 2026
                        </span>

                    </div>


                    <h3 class="text-2xl font-bold mt-5">
                        MongoDB Basics
                    </h3>


                    <p class="text-gray-400 mt-3 leading-relaxed">
                        Introduction to MongoDB databases,
                        collections, documents, CRUD operations
                        and connecting MongoDB with Node.js.
                    </p>


                    <div class="flex flex-wrap gap-2 mt-5">

                        <span class="text-xs bg-gray-800
                                     text-gray-400
                                     px-2 py-1 rounded">
                            MongoDB
                        </span>

                        <span class="text-xs bg-gray-800
                                     text-gray-400
                                     px-2 py-1 rounded">
                            Database
                        </span>

                    </div>


                    <a href="#"
                       class="inline-block mt-6
                              text-blue-400
                              font-semibold
                              hover:text-blue-300">
                        Read Note →
                    </a>

                </article>

            </div>

        </div>

    </section>



    <!-- ================= NEWSLETTER / CTA ================= -->

    <section class="py-20 bg-blue-600">

        <div class="max-w-4xl mx-auto px-6 text-center">

            <h2 class="text-3xl md:text-4xl font-bold">
                Keep Learning, Keep Building
            </h2>

            <p class="text-blue-100 mt-4 text-lg">
                Explore my notes and learn more about web development,
                programming and software engineering.
            </p>

            <a href="/contact"
               class="inline-block mt-7
                      bg-white
                      text-blue-600
                      px-7 py-3
                      rounded-lg
                      font-bold
                      hover:bg-gray-100
                      transition">
                Contact Me
            </a>

        </div>

    </section>



    <!-- ================= FOOTER ================= -->

    <footer class="bg-gray-950 border-t border-gray-800 py-8">

        <div class="max-w-7xl mx-auto px-6">

            <div class="flex flex-col
                        md:flex-row
                        justify-between
                        items-center
                        gap-4">

                <p class="text-gray-500 text-sm">
                    © 2026 MyPortfolio. All Rights Reserved.
                </p>


                <div class="flex gap-6">

                    <a href="#"
                       class="text-gray-500
                              hover:text-blue-400">
                        GitHub
                    </a>

                    <a href="#"
                       class="text-gray-500
                              hover:text-blue-400">
                        LinkedIn
                    </a>

                    <a href="#"
                       class="text-gray-500
                              hover:text-blue-400">
                        Instagram
                    </a>

                </div>

            </div>

        </div>

    </footer>

    <%- include('partials/Footer') %>
</body>
</html>

