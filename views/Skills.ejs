<%- include('partials/Navbar.ejs') %>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Skills</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>

</head>

<body class="bg-gray-950 text-white">

    <!-- ================= SKILLS HERO ================= -->

    <section class="py-20 bg-gray-950">

        <div class="max-w-5xl mx-auto px-6 text-center">

            <p class="text-blue-400 font-semibold tracking-widest">
                MY SKILLS
            </p>

            <h1 class="text-4xl md:text-5xl font-bold mt-3">
                Technical Skills & Expertise
            </h1>

            <p class="text-gray-400 max-w-3xl mx-auto mt-6 text-lg leading-relaxed">
                I continuously develop my technical knowledge and
                improve my skills by working on real-world projects
                and learning modern web technologies.
            </p>

        </div>

    </section>
    <!-- ================= TECHNICAL SKILLS ================= -->

    <section class="py-16 bg-gray-900">

        <div class="max-w-7xl mx-auto px-6">

            <div class="text-center mb-12">

                <h2 class="text-3xl md:text-4xl font-bold">
                    Technical Skills
                </h2>

                <p class="text-gray-400 mt-3">
                    Technologies and programming skills I work with.
                </p>

            </div>


            <div class="grid md:grid-cols-2 gap-8">


                <!-- HTML -->
                <div class="bg-gray-950
                            border border-gray-800
                            rounded-xl
                            p-6
                            hover:border-blue-500
                            transition">

                    <div class="flex justify-between mb-3">

                        <h3 class="font-semibold text-lg">
                            HTML
                        </h3>

                        <span class="text-blue-400">
                            90%
                        </span>

                    </div>

                    <div class="w-full bg-gray-800 rounded-full h-3">

                        <div class="bg-orange-500
                                    h-3 rounded-full"
                             style="width: 90%;">
                        </div>

                    </div>

                </div>



                <!-- CSS -->
                <div class="bg-gray-950
                            border border-gray-800
                            rounded-xl
                            p-6
                            hover:border-blue-500
                            transition">

                    <div class="flex justify-between mb-3">

                        <h3 class="font-semibold text-lg">
                            CSS
                        </h3>

                        <span class="text-blue-400">
                            85%
                        </span>

                    </div>

                    <div class="w-full bg-gray-800 rounded-full h-3">

                        <div class="bg-blue-500
                                    h-3 rounded-full"
                             style="width: 85%;">
                        </div>

                    </div>

                </div>



                <!-- JavaScript -->
                <div class="bg-gray-950
                            border border-gray-800
                            rounded-xl
                            p-6
                            hover:border-blue-500
                            transition">

                    <div class="flex justify-between mb-3">

                        <h3 class="font-semibold text-lg">
                            JavaScript
                        </h3>

                        <span class="text-blue-400">
                            80%
                        </span>

                    </div>

                    <div class="w-full bg-gray-800 rounded-full h-3">

                        <div class="bg-yellow-500
                                    h-3 rounded-full"
                             style="width: 80%;">
                        </div>

                    </div>

                </div>



                <!-- React -->
                <div class="bg-gray-950
                            border border-gray-800
                            rounded-xl
                            p-6
                            hover:border-blue-500
                            transition">

                    <div class="flex justify-between mb-3">

                        <h3 class="font-semibold text-lg">
                            React.js
                        </h3>

                        <span class="text-blue-400">
                            75%
                        </span>

                    </div>

                    <div class="w-full bg-gray-800 rounded-full h-3">

                        <div class="bg-cyan-500
                                    h-3 rounded-full"
                             style="width: 75%;">
                        </div>

                    </div>

                </div>



                <!-- Node.js -->
                <div class="bg-gray-950
                            border border-gray-800
                            rounded-xl
                            p-6
                            hover:border-blue-500
                            transition">

                    <div class="flex justify-between mb-3">

                        <h3 class="font-semibold text-lg">
                            Node.js
                        </h3>

                        <span class="text-blue-400">
                            70%
                        </span>

                    </div>

                    <div class="w-full bg-gray-800 rounded-full h-3">

                        <div class="bg-green-500
                                    h-3 rounded-full"
                             style="width: 70%;">
                        </div>

                    </div>

                </div>



                <!-- MongoDB -->
                <div class="bg-gray-950
                            border border-gray-800
                            rounded-xl
                            p-6
                            hover:border-blue-500
                            transition">

                    <div class="flex justify-between mb-3">

                        <h3 class="font-semibold text-lg">
                            MongoDB
                        </h3>

                        <span class="text-blue-400">
                            70%
                        </span>

                    </div>

                    <div class="w-full bg-gray-800 rounded-full h-3">

                        <div class="bg-green-600
                                    h-3 rounded-full"
                             style="width: 70%;">
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>



    <!-- ================= OTHER SKILLS ================= -->

    <section class="py-20 bg-gray-950">

        <div class="max-w-7xl mx-auto px-6">

            <div class="text-center mb-12">

                <p class="text-blue-400 font-semibold">
                    OTHER SKILLS
                </p>

                <h2 class="text-3xl md:text-4xl font-bold mt-2">
                    Tools & Technologies
                </h2>

            </div>


            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-6">


                <!-- Git -->
                <div class="bg-gray-900
                            border border-gray-800
                            rounded-xl
                            p-6 text-center
                            hover:border-blue-500
                            hover:-translate-y-2
                            transition">

                    <div class="text-4xl mb-3">
                        🔧
                    </div>

                    <h3 class="font-bold text-lg">
                        Git
                    </h3>

                    <p class="text-gray-400 text-sm mt-2">
                        Version Control
                    </p>

                </div>


                <!-- GitHub -->
                <div class="bg-gray-900
                            border border-gray-800
                            rounded-xl
                            p-6 text-center
                            hover:border-blue-500
                            hover:-translate-y-2
                            transition">

                    <div class="text-4xl mb-3">
                        💻
                    </div>

                    <h3 class="font-bold text-lg">
                        GitHub
                    </h3>

                    <p class="text-gray-400 text-sm mt-2">
                        Code Repository
                    </p>

                </div>


                <!-- VS Code -->
                <div class="bg-gray-900
                            border border-gray-800
                            rounded-xl
                            p-6 text-center
                            hover:border-blue-500
                            hover:-translate-y-2
                            transition">

                    <div class="text-4xl mb-3">
                        📝
                    </div>

                    <h3 class="font-bold text-lg">
                        VS Code
                    </h3>

                    <p class="text-gray-400 text-sm mt-2">
                        Code Editor
                    </p>

                </div>


                <!-- Responsive Design -->
                <div class="bg-gray-900
                            border border-gray-800
                            rounded-xl
                            p-6 text-center
                            hover:border-blue-500
                            hover:-translate-y-2
                            transition">

                    <div class="text-4xl mb-3">
                        📱
                    </div>

                    <h3 class="font-bold text-lg">
                        Responsive Design
                    </h3>

                    <p class="text-gray-400 text-sm mt-2">
                        Mobile Friendly UI
                    </p>

                </div>

            </div>

        </div>

    </section>



    <!-- ================= SOFT SKILLS ================= -->

    <section class="py-20 bg-gray-900">

        <div class="max-w-5xl mx-auto px-6">

            <div class="text-center mb-12">

                <p class="text-blue-400 font-semibold">
                    SOFT SKILLS
                </p>

                <h2 class="text-3xl md:text-4xl font-bold mt-2">
                    Professional Strengths
                </h2>

            </div>


            <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-6">

                <div class="bg-gray-950 p-6 rounded-xl border border-gray-800">
                    <h3 class="font-bold text-xl">
                        Problem Solving
                    </h3>

                    <p class="text-gray-400 mt-2">
                        Ability to analyze problems and develop practical solutions.
                    </p>
                </div>


                <div class="bg-gray-950 p-6 rounded-xl border border-gray-800">
                    <h3 class="font-bold text-xl">
                        Teamwork
                    </h3>

                    <p class="text-gray-400 mt-2">
                        Comfortable working with teams and sharing ideas.
                    </p>
                </div>


                <div class="bg-gray-950 p-6 rounded-xl border border-gray-800">
                    <h3 class="font-bold text-xl">
                        Communication
                    </h3>

                    <p class="text-gray-400 mt-2">
                        Clear communication and effective collaboration.
                    </p>
                </div>


                <div class="bg-gray-950 p-6 rounded-xl border border-gray-800">
                    <h3 class="font-bold text-xl">
                        Creativity
                    </h3>

                    <p class="text-gray-400 mt-2">
                        Creating modern and user-friendly digital experiences.
                    </p>
                </div>


                <div class="bg-gray-950 p-6 rounded-xl border border-gray-800">
                    <h3 class="font-bold text-xl">
                        Time Management
                    </h3>

                    <p class="text-gray-400 mt-2">
                        Managing tasks efficiently and meeting project deadlines.
                    </p>
                </div>


                <div class="bg-gray-950 p-6 rounded-xl border border-gray-800">
                    <h3 class="font-bold text-xl">
                        Continuous Learning
                    </h3>

                    <p class="text-gray-400 mt-2">
                        Always learning new technologies and development techniques.
                    </p>
                </div>

            </div>

        </div>

    </section>



    <!-- ================= CTA ================= -->

    <section class="py-16 bg-blue-600">

        <div class="max-w-4xl mx-auto px-6 text-center">

            <h2 class="text-3xl md:text-4xl font-bold">
                Let's Build Something Great
            </h2>

            <p class="text-blue-100 mt-4">
                Interested in working together? Let's discuss your next project.
            </p>

            <a href="/contact"
               class="inline-block
                      mt-7
                      bg-white
                      text-blue-600
                      px-7 py-3
                      rounded-lg
                      font-bold
                      hover:bg-gray-100
                      transition">
                Contact Me
            </a>

        </div>

    </section>



    <!-- ================= FOOTER ================= -->

    <footer class="bg-gray-950 border-t border-gray-800 py-8">

        <div class="max-w-7xl mx-auto px-6">

            <div class="flex flex-col md:flex-row
                        justify-between items-center gap-4">

                <p class="text-gray-500 text-sm">
                    © 2026 MyPortfolio. All Rights Reserved.
                </p>

                <div class="flex gap-6">

                    <a href="#"
                       class="text-gray-500 hover:text-blue-400">
                        GitHub
                    </a>

                    <a href="#"
                       class="text-gray-500 hover:text-blue-400">
                        LinkedIn
                    </a>

                    <a href="#"
                       class="text-gray-500 hover:text-blue-400">
                        Instagram
                    </a>
                </div>
            </div>
        </div>
    </footer>
   <%- include('partials/Footer.ejs') %> 
</body>
</html>
