<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Portfolio Navbar</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-slate-950 text-white antialiased">
    <nav class="sticky top-0 z-50 border-b border-white/10 bg-slate-950/80 backdrop-blur-xl shadow-lg shadow-blue-900/10">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <div class="flex h-20 items-center justify-between gap-6">
                <a href="/" class="group flex items-center gap-3">
                   
                    <span class="bg-gradient-to-r from-blue-400 via-cyan-300 to-sky-500 bg-clip-text text-2xl font-extrabold tracking-[0.18em] text-transparent">
                        PORTFOLIO
                    </span>
                </a>

                <% if (isLoggedIn) { %>
                    <div class="hidden items-center gap-2 md:flex">
                        <a href="/home" class="rounded-full px-4 py-2 text-sm font-medium text-slate-300 transition-all duration-200 hover:bg-slate-800 hover:text-blue-300">Home</a>
                        <a href="/about" class="rounded-full px-4 py-2 text-sm font-medium text-slate-300 transition-all duration-200 hover:bg-slate-800 hover:text-blue-300">About</a>
                        <a href="/skills" class="rounded-full px-4 py-2 text-sm font-medium text-slate-300 transition-all duration-200 hover:bg-slate-800 hover:text-blue-300">Skills</a>
                        <a href="/project" class="rounded-full px-4 py-2 text-sm font-medium text-slate-300 transition-all duration-200 hover:bg-slate-800 hover:text-blue-300">Projects</a>
                        <a href="/notes" class="rounded-full px-4 py-2 text-sm font-medium text-slate-300 transition-all duration-200 hover:bg-slate-800 hover:text-blue-300">Notes</a>
                        <a href="/contact" class="rounded-full px-4 py-2 text-sm font-medium text-slate-300 transition-all duration-200 hover:bg-slate-800 hover:text-blue-300">Contact</a>
                    </div>
                <% } %>

                <div class="flex items-center gap-3">
                    <% if (!isLoggedIn) { %>
                        <div class="hidden items-center gap-3 md:flex">
                            <a href="/login" class="rounded-xl border border-blue-400/60 bg-slate-900/70 px-5 py-2.5 text-sm font-semibold text-blue-300 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:bg-blue-500 hover:text-white hover:shadow-blue-500/30">
                                Login
                            </a>
                            <a href="/signup" class="rounded-xl bg-gradient-to-r from-blue-600 to-cyan-500 px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-blue-600/30 transition-all duration-200 hover:-translate-y-0.5 hover:from-blue-500 hover:to-cyan-400">
                                Sign Up
                            </a>
                        </div>
                    <% } else { %>
                        <form action="/logout" method="POST">
                            <button type="submit" class="rounded-xl border border-blue-400/60 bg-slate-900/70 px-5 py-2.5 text-sm font-semibold text-blue-300 transition-all duration-200 hover:-translate-y-0.5 hover:bg-blue-500 hover:text-white hover:shadow-blue-500/30">
                                Logout
                            </button>
                        </form>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>
</body>
</html>